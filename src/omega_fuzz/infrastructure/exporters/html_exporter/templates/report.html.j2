<!DOCTYPE html>
<html lang="{{ html_lang() }}" dir="{{ html_dir() }}">
<head>
<meta charset="utf-8">
<title>{{ _("Rapport {scanner_name} — {target_url}").format(scanner_name=header.scanner_name, target_url=header.target_url) }}</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: {{ palette.foreground }}; background: {{ palette.background }}; line-height: 1.5; }
  h1, h2, h3 { color: {{ palette.foreground }}; border-bottom: 2px solid {{ palette.accent }}; padding-bottom: 0.3rem; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { border: 1px solid {{ palette.panel }}; padding: 0.4rem 0.6rem; text-align: left; }
  th { background: {{ palette.surface }}; width: 14rem; color: {{ palette.secondary }}; }
  .banner-warning { background: {{ palette.surface }}; border: 1px solid {{ palette.warning }}; color: {{ palette.foreground }}; padding: 0.75rem 1rem; border-radius: 4px; margin: 1rem 0; }
  .severity { display: inline-block; color: {{ palette.background }}; padding: 0.1rem 0.6rem; border-radius: 3px; font-weight: 600; }
  .severity-critical { background: {{ palette.error }}; }
  .severity-high { background: {{ palette.warning }}; }
  .severity-medium { background: {{ palette.secondary }}; }
  .severity-low { background: {{ palette.panel }}; color: {{ palette.foreground }}; }
  .finding { border: 1px solid {{ palette.panel }}; background: {{ palette.surface }}; border-radius: 6px; padding: 1rem; margin: 1rem 0; }
  code { background: {{ palette.panel }}; color: {{ palette.foreground }}; padding: 0.1rem 0.3rem; border-radius: 3px; }
</style>
</head>
<body>

<h1>{{ _("Rapport {scanner_name}").format(scanner_name=header.scanner_name) }}</h1>
<table>
  <tr><th>{{ _("Version") }}</th><td>{{ header.version }}</td></tr>
  <tr><th>{{ _("Scan ID") }}</th><td><code>{{ header.scan_id }}</code></td></tr>
  <tr><th>{{ _("Généré le") }}</th><td>{{ header.generated_at.isoformat() }}</td></tr>
  <tr><th>{{ _("Cible") }}</th><td>{{ header.target_url }}</td></tr>
  <tr><th>{{ _("Preset") }}</th><td>{{ header.preset }}</td></tr>
  <tr><th>{{ _("Vérification TLS") }}</th><td>{% if header.tls_verification_enabled %}{{ _("activée") }}{% else %}<strong>{{ _("DÉSACTIVÉE") }}</strong>{% endif %}</td></tr>
  {% if header.catalog_versions %}
  <tr><th>{{ _("Versions des catalogues") }}</th><td>{% for name, version in header.catalog_versions.items() %}{{ name }}={{ version }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
  {% endif %}
</table>
{% if not header.tls_verification_enabled %}
<div class="banner-warning"><strong>{{ _("ATTENTION") }}</strong> {{ _(": la vérification TLS était désactivée pour ce scan. Les résultats peuvent avoir été obtenus via une connexion interceptée ou usurpée.") }}</div>
{% endif %}

<h2>{{ _("Résumé exécutif") }}</h2>
<p>
  {{ _("{findings} finding(s) —").format(findings=(findings|length)) }}
  <span class="severity severity-critical">{{ _("{critical} critique(s)").format(critical=severities.critical) }}</span>
  <span class="severity severity-high">{{ _("{high} élevé(s)").format(high=severities.high) }}</span>
  <span class="severity severity-medium">{{ _("{medium} moyen(s)").format(medium=severities.medium) }}</span>
  <span class="severity severity-low">{{ _("{low} faible(s)").format(low=severities.low) }}</span>
</p>
<p>{{ _("Terminaison : {termination_sentence}").format(termination_sentence=termination_sentence) }}</p>
{% if configuration.warnings %}
<p><strong>{{ _("Avertissements") }}</strong> : {{ configuration.warnings|join('; ') }}</p>
{% endif %}

<h2>{{ _("Cible et scan ID") }}</h2>
<p>{{ _("Cible : {target_url}").format(target_url=header.target_url) }}<br>{{ _("Scan ID :") }} <code>{{ header.scan_id }}</code></p>

<h2>{{ _("Preset, profils et surcharges") }}</h2>
<ul>
  <li>{{ _("Preset : {preset}").format(preset=header.preset) }}</li>
  <li>{{ _("Agressivité : {aggressiveness}").format(aggressiveness=configuration.aggressiveness.value) }}</li>
  <li>{{ _("Profil de scope : {scope_profile}").format(scope_profile=configuration.scope_profile.value) }}</li>
  <li>{{ _("Confirmation requise :") }} {% if configuration.requires_confirmation %}{{ _("oui") }}{% else %}{{ _("non") }}{% endif %}</li>
  <li>{{ _("Surcharges utilisateur :") }}
    {% if configuration.overrides %}{% for name, value in configuration.overrides.items() %}{{ name }}={{ value }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}{{ _("aucune") }}{% endif %}
  </li>
</ul>

<h2>{{ _("Scope effectif et exclusions") }}</h2>
<ul>
  <li>{{ _("Host racine : {root_host}").format(root_host=configuration.scope.root_host) }}</li>
  <li>{{ _("Mode : {mode}").format(mode=configuration.scope.mode.value) }}</li>
  <li>{{ _("Schémas autorisés : {allowed_schemes}").format(allowed_schemes=(configuration.scope.allowed_schemes|sort|join(', '))) }}</li>
  <li>{{ _("Port : {scope_port}").format(scope_port=configuration.scope.scope_port) }}</li>
  <li>{{ _("Profondeur max : {max_depth}").format(max_depth=configuration.scope.max_depth) }}</li>
  {% if configuration.scope.allowed_subdomains %}<li>{{ _("Sous-domaines autorisés : {allowed_subdomains}").format(allowed_subdomains=(configuration.scope.allowed_subdomains|sort|join(', '))) }}</li>{% endif %}
  {% if configuration.scope.blocked_subdomains %}<li>{{ _("Sous-domaines bloqués : {blocked_subdomains}").format(blocked_subdomains=(configuration.scope.blocked_subdomains|sort|join(', '))) }}</li>{% endif %}
  {% if configuration.scope.allowed_paths %}<li>{{ _("Chemins autorisés : {allowed_paths}").format(allowed_paths=(configuration.scope.allowed_paths|join(', '))) }}</li>{% endif %}
  {% if configuration.scope.blocked_paths %}<li>{{ _("Chemins bloqués : {blocked_paths}").format(blocked_paths=(configuration.scope.blocked_paths|join(', '))) }}</li>{% endif %}
</ul>
<h3>{{ _("Découverte") }}</h3>
<table>
  <tr><th>{{ _("URLs vues") }}</th><td>{{ statistics.urls_seen }}</td></tr>
  <tr><th>{{ _("Dans le scope") }}</th><td>{{ statistics.urls_in_scope }}</td></tr>
  <tr><th>{{ _("Hors scope") }}</th><td>{{ statistics.urls_out_of_scope }}</td></tr>
  <tr><th>{{ _("Au-delà de la profondeur") }}</th><td>{{ statistics.urls_beyond_depth }}</td></tr>
</table>
<h3>{{ _("Redirections") }}</h3>
<table>
  <tr><th>{{ _("Suivies") }}</th><td>{{ statistics.redirects_followed }}</td></tr>
  <tr><th>{{ _("Ignorées (externes)") }}</th><td>{{ statistics.redirects_external_ignored }}</td></tr>
  <tr><th>{{ _("Ignorées (hors scope)") }}</th><td>{{ statistics.redirects_out_of_scope_ignored }}</td></tr>
</table>

<h2>{{ _("Limites configurées") }}</h2>
<table>
  <tr><th>{{ _("Durée max") }}</th><td>{{ configuration.limits.max_duration_seconds }} s</td></tr>
  <tr><th>{{ _("Requêtes max") }}</th><td>{{ configuration.limits.max_total_requests }}</td></tr>
  <tr><th>{{ _("Tests max") }}</th><td>{{ configuration.limits.max_tests }}</td></tr>
  <tr><th>{{ _("Concurrence max") }}</th><td>{{ configuration.limits.max_concurrent_requests }}</td></tr>
</table>

<h2>{{ _("Raison de terminaison") }}</h2>
<p>{{ termination_sentence }}</p>

<h2>{{ _("Statistiques de requêtes") }}</h2>
<p>{{ _("Ces compteurs correspondent à la découverte et aux tests de sécurité, pas à un test de charge.") }}</p>
<table>
  <tr><th>{{ _("Total") }}</th><td>{{ statistics.total_requests }}</td></tr>
  <tr><th>{{ _("Découverte") }}</th><td>{{ statistics.discovery_requests }}</td></tr>
  <tr><th>{{ _("Test") }}</th><td>{{ statistics.test_requests }}</td></tr>
</table>
<h3>{{ _("Par module") }}</h3>
<table>
  {% for module, count in requests_by_module.items()|sort %}<tr><th>{{ module }}</th><td>{{ count }}</td></tr>{% else %}<tr><td colspan="2">{{ _("(aucune requête de test)") }}</td></tr>{% endfor %}
</table>
<h3>{{ _("Par statut") }}</h3>
<table>
  <tr><th>2xx</th><td>{{ statistics.status_2xx }}</td></tr>
  <tr><th>3xx</th><td>{{ statistics.status_3xx }}</td></tr>
  <tr><th>4xx</th><td>{{ statistics.status_4xx }}</td></tr>
  <tr><th>5xx</th><td>{{ statistics.status_5xx }}</td></tr>
  <tr><th>{{ _("Timeouts") }}</th><td>{{ statistics.timeouts }}</td></tr>
  <tr><th>{{ _("Erreurs de transport") }}</th><td>{{ statistics.transport_errors }}</td></tr>
</table>

<h2>{{ _("Statistiques de tests") }}</h2>
<table>
  <tr><th>{{ _("Planifiés") }}</th><td>{{ tests|length }}</td></tr>
  <tr><th>{{ _("Exécutés") }}</th><td>{{ statistics.tests_executed }}</td></tr>
  <tr><th>{{ _("Terminés") }}</th><td>{{ statistics.tests_completed }}</td></tr>
  <tr><th>{{ _("Abandonnés") }}</th><td>{{ statistics.tests_aborted }}</td></tr>
  <tr><th>{{ _("Non concluants") }}</th><td>{{ statistics.tests_inconclusive }}</td></tr>
</table>
<h3>{{ _("Par type") }}</h3>
<table>
  {% for type_name, count in tests_by_type.items()|sort %}<tr><th>{{ type_name }}</th><td>{{ count }}</td></tr>{% else %}<tr><td colspan="2">{{ _("(aucun test)") }}</td></tr>{% endfor %}
</table>

<h2>{{ _("Findings par sévérité") }}</h2>
<table>
  <tr><th>{{ _("Total") }}</th><td>{{ findings|length }}</td></tr>
  <tr><th>{{ _("Critique") }}</th><td>{{ severities.critical }}</td></tr>
  <tr><th>{{ _("Élevé") }}</th><td>{{ severities.high }}</td></tr>
  <tr><th>{{ _("Moyen") }}</th><td>{{ severities.medium }}</td></tr>
  <tr><th>{{ _("Faible") }}</th><td>{{ severities.low }}</td></tr>
</table>

<h2>{{ _("Détail des findings") }}</h2>
{% if not findings %}
<p>{{ _("Aucun finding.") }}</p>
{% endif %}
{% for finding in findings %}
<div class="finding">
  <h3>{{ finding.finding_id }} — {{ finding.title | tr }}</h3>
  <p>
    <span class="severity severity-{{ finding.severity.value }}">{{ finding.severity.value }}</span>
    {{ _("— statut {status} — type {type} — confiance {confidence}").format(status=finding.status.value, type=finding.type, confidence=finding.metadata.confidence.value) }}
  </p>
  <p><strong>{{ _("Cible") }}</strong> {{ _(": {method} {endpoint} (paramètre : {parameter})").format(method=finding.target.method, endpoint=finding.target.endpoint, parameter=(finding.target.parameter or 'N/A')) }}</p>
  <p><strong>{{ _("Comportement observé") }}</strong> : {{ finding.evidence.observed_behavior | tr }}</p>
  <p><strong>{{ _("Extrait (expurgé)") }}</strong> : <code>{{ finding.evidence.evidence_summary | tr }}</code></p>
  <p>{{ _("Test ID :") }} <code>{{ finding.evidence.test_id }}</code> {{ _("— Request ID :") }} <code>{{ finding.evidence.request_id }}</code></p>
  {% if finding.severity_override %}
  <p><strong>{{ _("Sévérité ajustée manuellement") }}</strong> {{ _(": {severity_auto} -> {severity_override} — {severity_override_reason}").format(severity_auto=finding.severity_auto.value, severity_override=finding.severity_override.value, severity_override_reason=finding.severity_override_reason) }}</p>
  {% endif %}
</div>
{% endfor %}

<h2>{{ _("Annexes techniques") }}</h2>
<p>{{ _("Versions des catalogues :") }}
  {% if header.catalog_versions %}{% for name, version in header.catalog_versions.items() %}{{ name }}={{ version }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}N/A{% endif %}
</p>
<p>{{ _("Le détail brut complet (toutes les requêtes, tous les tests) est disponible dans l'export JSON correspondant.") }}</p>

</body>
</html>
